# Required: choose a long, private password before exposing the server.
PIKATRANSFER_PASSWORD=change-this-to-a-long-random-password
PORT=3000
HOST=0.0.0.0

# Optional TURN server for networks where direct WebRTC connections fail.
# Keep TURN credentials private; do not commit real credentials.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
